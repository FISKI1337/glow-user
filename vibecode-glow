local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local CFG = {
	enabled = true,
	color   = Color3.fromRGB(120, 200, 255),
	rainbow = false,
}

local COLORS = {
	Color3.fromRGB(255, 170, 255), Color3.fromRGB(255, 255, 150),
	Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 100, 100),
	Color3.fromRGB(120, 255, 150), Color3.fromRGB(255, 255, 255),
}

local player = Players.LocalPlayer
local char, addedConn
local parts = {}
local extras = {}
local removed = {}

local function apply(inst)
	if inst:IsA("BasePart") then
		if inst.Name == "HumanoidRootPart" or parts[inst] then return end
		parts[inst] = { Material = inst.Material, Color = inst.Color, Reflectance = inst.Reflectance }
		inst.Material = Enum.Material.SmoothPlastic
		inst.Reflectance = 0
		inst.Color = CFG.color
		if inst:IsA("MeshPart") then
			extras[inst] = { TextureID = inst.TextureID }
			inst.TextureID = ""
		end
	elseif inst:IsA("SpecialMesh") then
		if not extras[inst] then
			extras[inst] = { TextureId = inst.TextureId }
			inst.TextureId = ""
		end
	elseif inst:IsA("SurfaceAppearance") then
		removed[inst] = inst.Parent
		inst.Parent = nil
	elseif inst:IsA("Shirt") then
		extras[inst] = { ShirtTemplate = inst.ShirtTemplate }
		inst.ShirtTemplate = ""
	elseif inst:IsA("Pants") then
		extras[inst] = { PantsTemplate = inst.PantsTemplate }
		inst.PantsTemplate = ""
	elseif inst:IsA("ShirtGraphic") then
		extras[inst] = { Graphic = inst.Graphic }
		inst.Graphic = ""
	end
end

local function restore()
	if addedConn then addedConn:Disconnect() addedConn = nil end
	for p, d in pairs(parts) do
		if p.Parent then
			p.Material, p.Color, p.Reflectance = d.Material, d.Color, d.Reflectance
		end
	end
	for i, props in pairs(extras) do
		if i.Parent then
			for k, v in pairs(props) do i[k] = v end
		end
	end
	for i, par in pairs(removed) do
		if par and par.Parent then i.Parent = par end
	end
	parts, extras, removed = {}, {}, {}
end

local function paint()
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do apply(d) end
	if not addedConn then
		addedConn = char.DescendantAdded:Connect(function(d)
			if CFG.enabled then task.defer(apply, d) end
		end)
	end
end

local function setup(c)
	parts, extras, removed = {}, {}, {}
	if addedConn then addedConn:Disconnect() addedConn = nil end
	char = c
	if CFG.enabled then
		task.wait(0.5)
		paint()
	end
end

local hue = 0
RunService.Heartbeat:Connect(function(dt)
	if not CFG.enabled then return end
	if CFG.rainbow then
		hue = (hue + dt * 0.3) % 1
		CFG.color = Color3.fromHSV(hue, 0.8, 1)
	end
	for p in pairs(parts) do
		if p.Parent then p.Color = CFG.color end
	end
end)

-- ===== GUI =====
local gui = Instance.new("ScreenGui")
gui.Name = "ColorGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(200, 0)
frame.AutomaticSize = Enum.AutomaticSize.Y
frame.Position = UDim2.new(1, -210, 0.5, -80)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
frame.BackgroundTransparency = 0.1
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
local pad = Instance.new("UIPadding", frame)
pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
local list = Instance.new("UIListLayout", frame)
list.Padding = UDim.new(0, 8)
list.SortOrder = Enum.SortOrder.LayoutOrder

local order = 0
local function button(text, cb)
	order += 1
	local b = Instance.new("TextButton")
	b.LayoutOrder = order
	b.Size = UDim2.new(1, 0, 0, 28)
	b.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 14
	b.Text = text
	b.Parent = frame
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

button("Цвет: вкл", function(b)
	CFG.enabled = not CFG.enabled
	b.Text = "Цвет: " .. (CFG.enabled and "вкл" or "выкл")
	if CFG.enabled then paint() else restore() end
end)

order += 1
local row = Instance.new("Frame")
row.LayoutOrder = order
row.Size = UDim2.new(1, 0, 0, 28)
row.BackgroundTransparency = 1
row.Parent = frame
local rl = Instance.new("UIListLayout", row)
rl.FillDirection = Enum.FillDirection.Horizontal
rl.Padding = UDim.new(0, 4)
for _, c in ipairs(COLORS) do
	local cb = Instance.new("TextButton")
	cb.Size = UDim2.new(1 / #COLORS, -4, 1, 0)
	cb.BackgroundColor3 = c
	cb.Text = ""
	cb.Parent = row
	Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 6)
	cb.MouseButton1Click:Connect(function()
		CFG.rainbow = false
		CFG.color = c
	end)
end

button("Радуга: выкл", function(b)
	CFG.rainbow = not CFG.rainbow
	b.Text = "Радуга: " .. (CFG.rainbow and "вкл" or "выкл")
end)

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.H then gui.Enabled = not gui.Enabled end
end)

if player.Character then task.spawn(setup, player.Character) end
player.CharacterAdded:Connect(setup)
